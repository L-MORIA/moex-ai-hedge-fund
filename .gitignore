# Gitignore for moex-ai-hedge-fund

# Cached MOEX data
data/*.json

# Generated reports (runtime artifacts)
data/hedge_fund_report_*.md

# Debug prompt snapshots (contain hardcoded ticker data from test runs)
*_prompt.txt

# Temp files
/tmp/

# Python cache
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS files
Thumbs.db
.DS_Store

# IDE
.vscode/
.idea/
*.swp
